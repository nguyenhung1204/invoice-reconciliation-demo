# Copy this file to .env before running docker compose.
APP_PORT=8000
SECRET_KEY=replace-with-a-long-random-secret-before-sharing

MYSQL_DATABASE=invoice_reconciliation
MYSQL_USER=invoice_app
MYSQL_PASSWORD=invoice_app_password
MYSQL_ROOT_PASSWORD=root_dev_password

# Demo accounts (all use password "admin" until changed in your environment).
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=admin
ACCOUNTANT_EMAIL=ketoan@gmail.com
ACCOUNTANT_PASSWORD=admin
CHIEF_ACCOUNTANT_EMAIL=ketoantruong@gmail.com
CHIEF_ACCOUNTANT_PASSWORD=admin

# PaddleOCR CPU runtime is enabled. Set to 0 for a smaller manual-review-only image.
INSTALL_OCR=1
OCR_DEVICE=cpu
OCR_MIN_CONFIDENCE=0.80
CURRENCY_TOLERANCE=1
ITEM_SIMILARITY_THRESHOLD=90
